{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "tin": {
      "type": "string",
      "description": "Tax Identification Number"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "sole_trader",
        "partnership",
        "limited_company",
        "cooperative",
        "ngo",
        "government",
        "other"
      ],
      "description": "Type of business entity"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Business email"
    },
    "address": {
      "type": "string",
      "description": "Business address"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the company is VAT registered"
    },
    "vat_rate": {
      "type": "number",
      "default": 12.5,
      "description": "Default VAT rate percentage"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the company owner"
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.id": "{{user.data.current_company_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.id": "{{user.data.current_company_id}}"
            },
            {
              "user.data.current_company_role": {
                "$in": [
                  "owner",
                  "manager"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.id": "{{user.data.current_company_id}}"
            },
            {
              "user.data.current_company_role": "owner"
            }
          ]
        }
      ]
    }
  }
}