{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "tin": {
      "type": "string",
      "description": "Tax Identification Number"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Business email"
    },
    "address": {
      "type": "string",
      "description": "Business address"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the company is VAT registered"
    },
    "vat_rate": {
      "type": "number",
      "default": 12.5,
      "description": "Default VAT rate percentage"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the company owner"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}